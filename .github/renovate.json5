{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":gitSignOff",
    "helpers:pinGitHubActionDigestsToSemver",
    ":combinePatchMinorReleases",
    ":configMigration",
    ":enablePreCommit",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone"
  ],
  enabledManagers: [
    "github-actions",
    "pre-commit",
    "custom.regex",
  ],
  // Renovate has no native manager for CMake FetchContent, so the pinned
  // revisions in cmake/Dependencies.cmake are tracked via regex managers
  // instead, one per dependency, matching the `set(<DEP>_REV ...)` /
  // `set(<DEP>_VERSION ...)` line that feeds the FetchContent GIT_TAG.
  customManagers: [
    {
      customType: "regex",
      description: "Update the fiction revision pinned for CMake FetchContent",
      managerFilePatterns: [
        "cmake/Dependencies.cmake"
      ],
      matchStrings: [
        "set\\(\\s*FICTION_REV\\s+(?<currentDigest>[0-9a-f]{40})"
      ],
      depNameTemplate: "cda-tum/fiction",
      packageNameTemplate: "https://github.com/cda-tum/fiction",
      currentValueTemplate: "main",
      datasourceTemplate: "git-refs",
    },
    {
      customType: "regex",
      description: "Update the siqadconn revision pinned for CMake FetchContent",
      managerFilePatterns: [
        "cmake/Dependencies.cmake"
      ],
      matchStrings: [
        "set\\(\\s*SIQADCONN_REV\\s+(?<currentDigest>[0-9a-f]{40})"
      ],
      depNameTemplate: "siqad/siqadconn",
      packageNameTemplate: "https://github.com/siqad/siqadconn",
      currentValueTemplate: "master",
      datasourceTemplate: "git-refs",
    },
    {
      customType: "regex",
      description: "Update the Catch2 version pinned for CMake FetchContent",
      managerFilePatterns: [
        "cmake/Dependencies.cmake"
      ],
      matchStrings: [
        "set\\(\\s*CATCH2_VERSION\\s+(?<currentValue>[0-9.]+)"
      ],
      depNameTemplate: "catchorg/Catch2",
      packageNameTemplate: "catchorg/Catch2",
      datasourceTemplate: "github-tags",
      extractVersionTemplate: "^v(?<version>.+)$",
    }
  ],
  // Delegate the actual merge to GitHub's native auto-merge instead of Renovate polling
  // and merging itself, so it goes through the same "🚦 Check" required-status gate as
  // any other PR. Requires "Allow auto-merge" enabled in the repo's GitHub settings and
  // branch protection to require the "🚦 Check" context — both are admin-only follow-ups.
  platformAutomerge: true,
  // Every update Renovate opens here (github-actions, pre-commit, and the three
  // FetchContent dependencies, majors included) automerges once CI is green: nothing
  // currently reviews these beyond watching CI pass, so there's no manual gate to
  // preserve. Unlike a tarball+hash FetchContent setup, a git-SHA/tag pin has no
  // stale-hash failure mode, so automerge is safe here even for the dependency bumps.
  automerge: true,
  lockFileMaintenance: {
    enabled: true,
    automerge: true
  },
  schedule: [
    "every weekend"
  ],
  packageRules: [
    {
      matchManagers: [
        "github-actions"
      ],
      addLabels: [
        "github_actions"
      ],
      commitMessagePrefix: "⬆️👨‍💻",
      automerge: true
    },
    {
      matchManagers: [
        "pre-commit"
      ],
      addLabels: [
        "pre-commit"
      ],
      commitMessagePrefix: "⬆️🪝",
      versioning: "pep440",
      automerge: true
    },
    {
      matchManagers: [
        "custom.regex"
      ],
      addLabels: [
        "dependencies",
        "C++",
        "build_system"
      ],
      commitMessagePrefix: "⬆️📦",
      automerge: true
    },
    {
      description: "Group patch updates into one PR",
      groupName: "patch versions",
      groupSlug: "all-patch",
      matchUpdateTypes: [
        "patch"
      ]
    }
  ]
}
